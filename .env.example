# Copy to frontend/.env (or .env.local). No keys are needed for the bundled sample.
DEMO_MODE=true
# Set DATA_SOURCE=supabase after running schema.sql and the seed script.
DATA_SOURCE=demo
NEXT_PUBLIC_SUPABASE_URL=https://qvnmtgtqtktuqrmmhqtq.supabase.co
SUPABASE_URL=https://qvnmtgtqtktuqrmmhqtq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Optional direct connection for database tools; the app uses the HTTPS API.
# Percent-encode special characters in the password only, not the entire URL.
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.qvnmtgtqtktuqrmmhqtq.supabase.co:5432/postgres"
GEMINI_API_KEY=
LLM_PROVIDER=gemini
# Optional secondary provider: groq, gemini, or none. No automatic vendor switch by default.
LLM_FALLBACK_PROVIDER=none
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_REQUESTS_PER_MINUTE=4
GROQ_REQUESTS_PER_DAY=50
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Persistent global request budgets; adjust below your project's actual quotas.
GEMINI_REQUESTS_PER_MINUTE=4
GEMINI_REQUESTS_PER_DAY=50
# Optional >=32-character secret for signed, stateless follow-up context.
# Supabase service-role key is used when this is unset in Supabase mode.
SESSION_SECRET=
